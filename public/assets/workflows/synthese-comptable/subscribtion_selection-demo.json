    {
      "parameters": {
        "html": "{{\n(() => {\nconst FONT_MAIN = \"-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif\";\nconst FONT_STD = \"Arial,sans-serif\";\nconst COLOR_PRIMARY = \"#1B4332\";\nconst COLOR_SECONDARY = \"#1A1A2E\";\nconst COLOR_WARNING = \"#E9A800\";\nconst COLOR_MUTED = \"#868E96\";\nconst COLOR_BG_LIGHT = \"#F8F9FA\";\nconst COLOR_ALERT_BG = \"#FFF3CD\";\nconst COLOR_ALERT_TEXT = \"#856404\";\nconst COLOR_BORDER = \"#E9ECEF\";\n\nconst receiverEmail = \"[example@outlook.fr](mailto:example@outlook.fr)\";\nconst triggerSource = $json.source_primary || \"Système automatisé\";\nconst limit = $json.limitTime;\n\nconst formUrl = `https://example.com/form/subscription-management-portal?receiver=${receiverEmail}&redirect=example_redirect_url&source=${triggerSource}`;\n\nconst count = ($json.siren || []).length;\nconst timeStr = $now.setZone('Europe/Paris').plus({ hours: limit }).setLocale('fr').toFormat(\"EEEE d MMMM 'à' HH:mm\");\nconst plural = count > 1 ? 's' : '';\n\nreturn `\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" bgcolor=\"${COLOR_BG_LIGHT}\" style=\"background-color:${COLOR_BG_LIGHT};\">\n   <tr>\n      <td align=\"center\" style=\"padding:24px 16px;\">\n         <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n\n```\n        <tr>\n           <td bgcolor=\"${COLOR_PRIMARY}\" style=\"background-color:${COLOR_PRIMARY};border-radius:16px 16px 0 0;padding:24px 28px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                 <tr>\n                    <td valign=\"middle\">\n                       <span style=\"font-family:${FONT_MAIN};font-size:17px;font-weight:700;color:#FFFFFF;letter-spacing:-0.3px;\">\n                          Client anonymisé\n                       </span>\n                    </td>\n                    <td align=\"right\" valign=\"middle\">\n                       <span style=\"display:inline-block;background-color:${COLOR_WARNING};color:${COLOR_SECONDARY};font-family:${FONT_STD};font-size:10px;font-weight:700;letter-spacing:1px;padding:4px 10px;border-radius:4px;\">\n                          ACTION REQUISE\n                       </span>\n                    </td>\n                 </tr>\n              </table>\n           </td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"#FFFFFF\" style=\"background-color:#FFFFFF;padding:24px 28px 0;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                 <tr>\n                    <td bgcolor=\"${COLOR_ALERT_BG}\" style=\"background-color:${COLOR_ALERT_BG};border-left:4px solid ${COLOR_WARNING};border-radius:0 8px 8px 0;padding:14px 18px;\">\n                       <p style=\"margin:0 0 4px;font-family:${FONT_STD};font-size:13px;font-weight:700;color:${COLOR_ALERT_TEXT};\">\n                          ⚡ Console de pilotage mutualisée\n                       </p>\n                       <p style=\"margin:0;font-family:${FONT_STD};font-size:13px;color:${COLOR_ALERT_TEXT};line-height:1.5;\">\n                          Ce formulaire centralise la gestion des abonnements. Toute modification sera automatiquement répercutée sur l'ensemble des sources de données connectées.\n                       </p>\n                    </td>\n                 </tr>\n              </table>\n           </td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"#FFFFFF\" style=\"background-color:#FFFFFF;padding:20px 28px;\">\n              <p style=\"margin:0 0 14px;font-family:${FONT_STD};font-size:14px;color:#495057;line-height:1.7;\">\n                 Bonjour,\n              </p>\n              <p style=\"margin:0 0 14px;font-family:${FONT_STD};font-size:14px;color:#495057;line-height:1.7;\">\n                 Le système de synthèses déclenché par le workflow <b>${triggerSource}</b> a identifié <b style=\"color:${COLOR_SECONDARY};\">${count} entreprise${plural}</b> éligible${plural} pour la période en cours.\n              </p>\n              <p style=\"margin:0 0 14px;font-family:${FONT_STD};font-size:14px;color:#495057;line-height:1.7;\">\n                 Veuillez valider les entités devant recevoir leur synthèse et renseigner les budgets associés via le bouton ci-dessous.\n              </p>\n\n              <div style=\"text-align:center;margin:24px 0;\">\n                 <a href=\"${formUrl}\" style=\"background-color:${COLOR_WARNING};color:${COLOR_BG_LIGHT};font-family:${FONT_MAIN};font-size:15px;font-weight:700;text-decoration:none;padding:12px 24px;border-radius:6px;display:inline-block;\">Accéder à la console</a>\n              </div>\n\n              <p style=\"margin:0;font-family:${FONT_STD};font-size:14px;color:#495057;line-height:1.7;\">\n                 <b>Attention :</b> l'envoi des synthèses est suspendu à la validation de ce formulaire, manuelle ou automatique.\n              </p>\n           </td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"#FFFFFF\" style=\"background-color:#FFFFFF;padding:0 28px;\">\n              <div style=\"height:1px;background-color:${COLOR_BORDER};font-size:0;line-height:0;\">&nbsp;</div>\n           </td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"#FFFFFF\" style=\"background-color:#FFFFFF;padding:20px 28px 0;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                 <tr>\n                    <td width=\"50%\" valign=\"top\" bgcolor=\"${COLOR_BG_LIGHT}\" style=\"background-color:${COLOR_BG_LIGHT};border-radius:8px;padding:14px 16px;\">\n                       <p style=\"margin:0 0 2px;font-family:${FONT_STD};font-size:10px;font-weight:600;color:${COLOR_MUTED};text-transform:uppercase;letter-spacing:0.5px;\">Déclencheur</p>\n                       <p style=\"margin:0;font-family:${FONT_STD};font-size:14px;font-weight:700;color:${COLOR_SECONDARY};\">${triggerSource}</p>\n                    </td>\n                    <td width=\"16\" style=\"font-size:0;line-height:0;\">&nbsp;</td>\n                    <td width=\"50%\" valign=\"top\" bgcolor=\"${COLOR_BG_LIGHT}\" style=\"background-color:${COLOR_BG_LIGHT};border-radius:8px;padding:14px 16px;\">\n                       <p style=\"margin:0 0 2px;font-family:${FONT_STD};font-size:10px;font-weight:600;color:${COLOR_MUTED};text-transform:uppercase;letter-spacing:0.5px;\">Validation auto à</p>\n                       <p style=\"margin:0;font-family:${FONT_STD};font-size:14px;font-weight:700;color:${COLOR_WARNING};\">\n                          ${timeStr} (dans ${limit}h)\n                       </p>\n                    </td>\n                 </tr>\n              </table>\n           </td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"#FFFFFF\" style=\"background-color:#FFFFFF;height:28px;font-size:0;line-height:0;\">&nbsp;</td>\n        </tr>\n\n        <tr>\n           <td bgcolor=\"${COLOR_SECONDARY}\" style=\"background-color:${COLOR_SECONDARY};border-radius:0 0 16px 16px;padding:18px 28px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                 <tr>\n                    <td valign=\"middle\">\n                       <p style=\"margin:0 0 2px;font-family:${FONT_STD};font-size:12px;font-weight:600;color:#FFFFFF;\">Client anonymisé</p>\n                       <p style=\"margin:0;font-family:${FONT_STD};font-size:11px;color:${COLOR_MUTED};\">Service automatisation</p>\n                    </td>\n                    <td align=\"right\" valign=\"middle\">\n                       <p style=\"margin:0;font-family:${FONT_STD};font-size:11px;color:#495057;\">Envoi automatique</p>\n                    </td>\n                 </tr>\n              </table>\n           </td>\n        </tr>\n     </table>\n  </td>\n```\n\n   </tr>\n</table>\n  `;\n})()\n}}\n"
      },
